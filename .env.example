# Telegram Bot Configuration
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Sheets Configuration
# Option A: Path to credentials.json file downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Option B: Inline Service Account credentials (if NOT using credentials.json)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Sheet Details
# The ID is in the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_google_sheet_id_here
SHEET_NAME=Group Logs

# Optional: Timezone offset in hours relative to UTC (e.g. +7 for GMT+7, -5 for EST)
TIMEZONE_OFFSET_HOURS=+7
